{
  "info": {
    "name": "COVID-19 Map API",
    "description": "Manual test cases for the COVID-19 Map Dashboard API. Run `npm run migrate`, `npm run seed` and `npm run dev` first. The rate limit (120 requests/minute per IP) can be exercised by running the 'Health' request 130 times in the Collection Runner without delay.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Endpoints",
      "item": [
        {
          "name": "01 Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has X-Request-Id\", () => pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.be.a(\"string\"));",
                  "pm.test(\"status ok\", () => pm.expect(pm.response.json()).to.eql({ status: \"ok\" }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "02 Global totals",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has X-Request-Id\", () => pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.be.a(\"string\"));",
                  "pm.test(\"has cache header\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"public, max-age=300\"));",
                  "pm.test(\"global shape\", () => {",
                  "  const b = pm.response.json();",
                  "  [\"cases\",\"deaths\",\"todayCases\",\"todayDeaths\",\"affectedCountries\"].forEach((k) => pm.expect(b[k]).to.be.a(\"number\"));",
                  "  pm.expect(b.recovered).to.eql(null);",
                  "  pm.expect(b.active).to.eql(null);",
                  "  pm.expect(b.updatedAt).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/global",
              "host": ["{{baseUrl}}"],
              "path": ["global"]
            }
          }
        },
        {
          "name": "03 Global history (default 30)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has X-Request-Id\", () => pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.be.a(\"string\"));",
                  "pm.test(\"has cache header\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"public, max-age=300\"));",
                  "pm.test(\"history is valid\", () => {",
                  "  const { history } = pm.response.json();",
                  "  pm.expect(history.length).to.be.within(1, 30);",
                  "  history.forEach((p) => {",
                  "    [\"date\",\"cases\",\"deaths\",\"newCases\",\"newDeaths\"].forEach((k) => pm.expect(p).to.have.property(k));",
                  "    pm.expect(p.newCases).to.be.at.least(0);",
                  "    pm.expect(p.newDeaths).to.be.at.least(0);",
                  "  });",
                  "  const dates = history.map((p) => p.date);",
                  "  pm.expect(dates).to.eql([...dates].sort());",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/global/history",
              "host": ["{{baseUrl}}"],
              "path": ["global", "history"]
            }
          }
        },
